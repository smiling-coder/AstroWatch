# Copy this configuration into a local .env file if you use dotenv,
# or set the environment variables in your terminal/hosting service.

NASA_API_KEY=your_nasa_api_key_here

# Local frontend does not need a different origin when using
# the frontend and backend on the same origin.
#
# Example production value:
FRONTEND_ORIGIN=https://your-username.github.io

PORT=5000
FLASK_DEBUG=false
